# Dependencies (installed from composer.lock)
/vendor/

# Secrets and environment
.env
.env.*
!.env.example

# Runtime data
/storage/logs/*
!/storage/logs/.gitkeep
/storage/cache/*
!/storage/cache/.gitkeep
/storage/sessions/*
!/storage/sessions/.gitkeep
/storage/uploads/*
!/storage/uploads/.gitkeep
/storage/backups/*
!/storage/backups/.gitkeep

# Local tooling
.phpunit.result.cache
.phpstan-cache/
.idea/
.vscode/
.DS_Store
Thumbs.db
