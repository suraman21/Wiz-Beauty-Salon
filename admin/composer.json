{
    "name": "wiz/admin",
    "description": "WIZ Beauty Salon — plain PHP admin panel and JSON API",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-sodium": "*",
        "ezyang/htmlpurifier": "^4.19",
        "phpmailer/phpmailer": "^6.10"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.4"
    },
    "autoload": {
        "psr-4": {
            "Wiz\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Wiz\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "lint": "find src config database tests public bin -name '*.php' -print0 | xargs -0 -n1 php -l",
        "analyse": "php vendor/bin/phpstan analyse --no-progress",
        "unit": "php vendor/bin/phpunit",
        "security": "composer audit --locked --no-interaction",
        "db:status": "php database/migrate.php status",
        "db:migrate": "php database/migrate.php migrate",
        "quality": [
            "@lint",
            "@analyse",
            "@unit",
            "@security"
        ],
        "db:seed": "php database/seed.php",
        "db:rollback": "php database/migrate.php rollback"
    },
    "config": {
        "allow-plugins": false,
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.4.26"
        }
    }
}
