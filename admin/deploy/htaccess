# BEGIN WIZ APP
# Managed by the deploy pipeline. Do not edit on the server.
Options -Indexes

# The React site owns "/" — /api and /admin are routed to PHP explicitly below.
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. JSON API and 2. admin panel -> PHP front controller
  RewriteRule ^(api|admin)(/.*)?$ index.php [L,QSA]

  # 3. Real files and directories are served as-is (assets, /services/index.html)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 4. Everything else -> React shell (its router renders the 404 page)
  RewriteRule ^ index.html [L]
</IfModule>

# Never execute anything inside the public upload directory
<IfModule mod_rewrite.c>
  RewriteRule ^uploads/.*\.(php|phtml|phar|php[0-9])$ - [F,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
# END WIZ APP
