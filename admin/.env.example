# ---------------------------------------------------------------------------
# WIZ admin — environment configuration
# Copy to .env, fill in the values, then: chmod 600 .env
# Never commit .env. It lives outside the webroot.
# ---------------------------------------------------------------------------

APP_NAME="WIZ Beauty Salon"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://wiz.arkeonethiopia.com
APP_TIMEZONE=Africa/Addis_Ababa

# 32-byte key, base64 encoded. Generate once:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=

# --- Database -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=arkeonet_wiz
DB_USER=arkeonet_wiz
DB_PASS=
DB_CHARSET=utf8mb4

# --- Sessions -------------------------------------------------------------
SESSION_NAME=wiz_admin
SESSION_LIFETIME=7200
SESSION_SECURE=true

# --- Mail (defaults; the admin panel can override and toggle these) --------
MAIL_ENABLED=false
MAIL_ACTIVE_PROFILE=cpanel
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="WIZ Beauty Salon"

# Uploads
UPLOAD_MAX_BYTES=5242880
