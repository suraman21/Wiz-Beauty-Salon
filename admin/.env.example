# ---------------------------------------------------------------------------
# WIZ Beauty Salon — admin panel environment
#
# Copy to .env on the server and chmod 600. The file lives beside the code,
# outside the webroot: /home/arkeonet/wiz-app/.env
#
#   cp .env.example .env && chmod 600 .env
#
# Never commit .env. Never put real credentials in this example file.
# ---------------------------------------------------------------------------

APP_NAME="WIZ Beauty Salon"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://wiz.arkeonethiopia.com
APP_TIMEZONE=Africa/Addis_Ababa

# Signs the links customers use to cancel or move a booking. 64 hex characters.
# Generate with: php -r "echo bin2hex(random_bytes(32));"
# Changing it invalidates every link that has already been emailed.
APP_KEY=

# Session cookie. SESSION_SECURE must stay true in production; set it to false
# only when running the panel over plain HTTP on a local machine.
SESSION_NAME=wiz_admin
SESSION_LIFETIME=7200
SESSION_SECURE=true

# --- Database (cPanel, created in the arkeonet account) --------------------
DB_HOST=localhost
DB_NAME=arkeonet_wiz
DB_USER=arkeonet_wiz
DB_PASS=change-me
DB_CHARSET=utf8mb4
# The connection's time zone. Defaults to the offset of APP_TIMEZONE, so
# CURDATE() and NOW() agree with the clock the salon reads. Override only when
# the database host cannot accept the offset.
DB_TIMEZONE=+03:00

# --- Reverse proxy ---------------------------------------------------------
# Comma-separated addresses or CIDR ranges whose forwarding headers may be
# believed. In production this is Cloudflare's published ranges, e.g.
#   173.245.48.0/20,103.21.244.0/22,...
# Empty means "use REMOTE_ADDR only", which is safe but makes every visitor
# behind a proxy look like one address. Rate limits and login lockouts depend
# on this being right.
TRUSTED_PROXIES=

# --- Uploads ---------------------------------------------------------------
# The docroot's uploads/ directory: the web server serves files from there, so
# images appear on the public site without a PHP round-trip.
UPLOAD_PATH=/home/arkeonet/wiz.arkeonethiopia.com/uploads
UPLOAD_URL=/uploads
UPLOAD_MAX_BYTES=5242880

# --- Login throttling ------------------------------------------------------
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_PER_IP=25
LOGIN_LOCKOUT_MINUTES=15

# --- Housekeeping (bin/housekeeping.php) -----------------------------------
AUDIT_RETENTION_DAYS=365
LOG_RETENTION_DAYS=90

# --- First administrator (used once by database/seed.php) ------------------
ADMIN_NAME="Salon Administrator"
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Mail (Phase 5; stored in the settings table once the UI ships) --------
MAIL_ENABLED=false
MAIL_ACTIVE_PROFILE=cpanel
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="WIZ Beauty Salon"
# Where the salon's own notifications go (defaults to the From address).
MAIL_SALON_EMAIL=

MAIL_HOST=mail.wiz.arkeonethiopia.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=

MAIL_ALT_HOST=
MAIL_ALT_PORT=587
MAIL_ALT_ENCRYPTION=tls
MAIL_ALT_USERNAME=
MAIL_ALT_PASSWORD=
